cabal-version:      2.4
name:               desert-explorer
version:            0.1.0.0
synopsis:           Desert Explorer, a small exploration game in Haskell (terminal + Gloss GUI)
author:             Moussa Tallih
build-type:         Simple
extra-doc-files:    README.md

executable desert-explorer
    main-is:          Main.hs
    other-modules:    Game
                      GUI
                      Terminal
    hs-source-dirs:   DesertExplorer
    build-depends:    base >=4.14 && <5
                    , containers >=0.6 && <0.9
                    , gloss >=1.13 && <1.14
                    , random >=1.2 && <1.4
                    , stm >=2.5 && <2.6
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
